{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "morning-edition",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "durable_objects": {
    "bindings": [{ "name": "PRESS", "class_name": "Press" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Press"] }],
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": false },
}
